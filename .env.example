# --- Control plane (Vercel) ---------------------------------------------------
# Postgres connection string. For Supabase use the pooled (port 6543) string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Set to "no-verify" for Supabase's pooler certificate chain.
DATABASE_SSL=
# Public origin of this app; the worker calls back here and post-mortems link here.
APP_BASE_URL=
# Kane execution worker (see worker/). Both sides share the secret.
KANE_WORKER_URL=
WORKER_SHARED_SECRET=
# Signs verification receipts (HMAC-SHA256). Use 32+ random bytes.
HMAC_SECRET=
# Red/Blue agents: either key enables them (Groq is preferred).
GROQ_API_KEY=
GEMINI_API_KEY=
# GitHub: token needs contents:write + pull_requests:write on guarded repos.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Optional tuning. KANE_CREDIT_BUDGET is the credit allowance shown before the
# worker has reported a real `kane-cli balance` (e.g. 10000 for the hackathon grant).
KANE_CREDIT_BUDGET=
RUN_RATE_LIMIT_PER_HOUR=12
PREVIEW_DEPLOY_WAIT_S=90
KANE_POLICY_ID=

# --- Worker only (Render) -----------------------------------------------------
# LT_USERNAME=
# LT_ACCESS_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=evidence-packs
